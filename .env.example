# ============================================================
# AetherVector RAG - Configuración Localhost (.env)
# Copia este archivo a ".env" o ".env.local" para desarrollo local
# ============================================================

# Clave de Google AI Studio (Requerida para modelos Gemini y búsqueda web)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Clave opcional de NVIDIA NIM Microservices
NVIDIA_NIM_API_KEY="MY_NVIDIA_NIM_API_KEY"

# Puerto y host del servidor local (por defecto 3000)
APP_PORT=3000
HOST=0.0.0.0

# URL base de la aplicación (en local suele ser http://localhost:3000)
APP_URL="http://localhost:3000"

# Entorno de ejecución ("development" para Vite HMR o "production" para dist/ optimizado)
NODE_ENV=development
