    "@types/compression": "^1.8.1",
    "@types/katex": "^0.16.8",
    "@types/marked": "^5.0.2",
    "@types/multer": "^2.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "compression": "^1.8.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "katex": "^0.19.1",
    "lucide-react": "^0.546.0",
    "maath": "^0.10.8",
    "marked": "^18.1.3",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "tsx": "^4.21.0",
    "unpdf": "^2.1.0",
