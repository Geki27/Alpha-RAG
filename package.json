{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "local": "npm run check && npm run build && npm run start",
    "local:dev": "npm run check && npm run dev",
    "check": "node scripts/check-local.mjs",
    "preview": "vite preview",
    "clean": "node -e \"import('fs').then(fs => ['dist','server.js'].forEach(p => fs.rmSync(p,{recursive:true,force:true})))\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-three/drei": "^10.7.9",
